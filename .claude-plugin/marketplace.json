{
  "name": "pentest",
  "display_name": "Pentest Plugin",
  "version": "0.1.0",
  "description": "Full-cycle penetration testing plugin with evidence discipline. Covers recon, mapping, vulnerability hunting, finding chaining, adversarial validation, and reporting with MITRE/NIST/CVSS mapping.",
  "author": {
    "name": "mahumadad"
  },
  "license": "MIT",
  "repository": "https://github.com/mahumadad/pentest-plugin",
  "homepage": "https://github.com/mahumadad/pentest-plugin",
  "keywords": [
    "pentest",
    "security",
    "offensive-security",
    "vulnerability-assessment",
    "recon",
    "OWASP",
    "MITRE",
    "nuclei",
    "evidence-chain",
    "red-team"
  ],
  "categories": ["security", "testing"],
  "install": {
    "type": "git",
    "url": "https://github.com/mahumadad/pentest-plugin.git"
  },
  "requirements": {
    "python": ">=3.11",
    "pip": ["cryptography>=42,<48", "PyYAML>=6,<7", "requests>=2.31,<3", "urllib3>=2,<3"]
  },
  "optional_requirements": {
    "browser_verification": {
      "pip": ["playwright"],
      "post_install": "playwright install chromium"
    }
  },
  "external_tools": ["nmap", "nuclei", "ffuf", "httpx"],
  "commands": [
    "pt:engage", "pt:recon", "pt:hunt", "pt:chain", "pt:validate",
    "pt:report", "pt:scope", "pt:status", "pt:findings", "pt:map",
    "pt:export", "pt:deliver", "pt:closeout", "pt:retest", "pt:resume",
    "pt:run", "pt:notify", "pt:doctor"
  ],
  "agent_count": 18,
  "skill_count": 124,
  "workflow_count": 14,
  "documentation_url": "https://github.com/mahumadad/pentest-plugin#readme"
}
