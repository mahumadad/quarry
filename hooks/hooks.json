{
  "hooks": [
    {
      "matcher": "startup|resume|clear|compact",
      "event": "SessionStart",
      "commands": [
        "cat ${CLAUDE_PLUGIN_ROOT}/CLAUDE.md"
      ]
    },
    {
      "matcher": "",
      "event": "PreToolUse",
      "tool_name": "Bash",
      "commands": [
        "python3 ${CLAUDE_PLUGIN_ROOT}/engine/guard.py --command \"$TOOL_INPUT\""
      ]
    }
  ]
}
